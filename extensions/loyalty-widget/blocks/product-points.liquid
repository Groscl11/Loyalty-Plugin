{% comment %}
  Product Page Points Banner
  Shows how many points a customer earns for buying this product.
  For logged-in members: fetches their tier earn rate + balance from the GoSelf
  loyalty API and shows personalised points + tier badge.
  Add this block to any product template in the Theme Editor → Apps → Add block.
{% endcomment %}

{% assign product_price  = product.price | divided_by: 100.0 %}
{% assign pts_estimate   = product_price | divided_by: block.settings.points_divisor | times: block.settings.points_rate | ceil %}

<div class="rh-product-points" id="rh-product-points-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="rh-pp-inner">

    <span class="rh-pp-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    </span>

    <div class="rh-pp-content">
      <span class="rh-pp-label">{{ block.settings.label_text }}</span>
      <strong class="rh-pp-points" id="rh-pp-pts-{{ block.id }}">{{ pts_estimate }}</strong>
      <span class="rh-pp-name" id="rh-pp-name-{{ block.id }}">{{ block.settings.points_name }}</span>
    </div>

    {% if block.settings.show_tier_badge %}
    <span class="rh-pp-tier" id="rh-pp-tier-{{ block.id }}" style="display:none"></span>
    {% endif %}

    {% if block.settings.show_balance %}
    <div class="rh-pp-balance" id="rh-pp-bal-wrap-{{ block.id }}" style="display:none">
      <span class="rh-pp-bal-label">Balance: </span>
      <strong id="rh-pp-bal-{{ block.id }}">0</strong>
      <span id="rh-pp-bal-name-{{ block.id }}">{{ block.settings.points_name }}</span>
    </div>
    {% endif %}

    {% if block.settings.show_signin_nudge and customer == nil %}
    <a href="/account/login" class="rh-pp-signin">Sign in to earn</a>
    {% endif %}

    {% if block.settings.show_info_tooltip %}
    <div class="rh-pp-info-wrap" id="rh-pp-info-{{ block.id }}">
      <button class="rh-pp-info-btn" aria-label="Points info" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </button>
      <div class="rh-pp-tooltip" role="tooltip">
        <ul class="rh-pp-tooltip-list">
          {% unless block.settings.tooltip_line_1 == blank %}
          <li>{{ block.settings.tooltip_line_1 }}</li>
          {% endunless %}
          {% unless block.settings.tooltip_line_2 == blank %}
          <li>{{ block.settings.tooltip_line_2 }}</li>
          {% endunless %}
          {% unless block.settings.tooltip_line_3 == blank %}
          <li>{{ block.settings.tooltip_line_3 }}</li>
          {% endunless %}
        </ul>
        {% if block.settings.tooltip_link_url != blank and block.settings.tooltip_link_text != blank %}
        <a href="{{ block.settings.tooltip_link_url }}" class="rh-pp-tooltip-link" target="_blank" rel="noopener">{{ block.settings.tooltip_link_text }}</a>
        {% endif %}
      </div>
    </div>
    {% endif %}

  </div>
</div>

<style>
  #rh-product-points-{{ block.id }} {
    font-family: inherit;
    font-size: 14px;
    color: {{ block.settings.text_color }};
  }
  #rh-product-points-{{ block.id }} .rh-pp-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    background: {{ block.settings.bg_color }};
    border: 1.5px solid {{ block.settings.primary_color }}33;
    border-radius: {{ block.settings.border_radius }}px;
    padding: 10px 14px;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
  }
  #rh-product-points-{{ block.id }} .rh-pp-icon {
    flex-shrink: 0;
    color: {{ block.settings.primary_color }};
    display: flex;
    align-items: center;
  }
  #rh-product-points-{{ block.id }} .rh-pp-content {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  #rh-product-points-{{ block.id }} .rh-pp-points {
    color: {{ block.settings.primary_color }};
    font-size: 16px;
    font-weight: 700;
  }
  #rh-product-points-{{ block.id }} .rh-pp-name {
    font-weight: 600;
    color: {{ block.settings.primary_color }};
  }
  #rh-product-points-{{ block.id }} .rh-pp-tier {
    background: {{ block.settings.primary_color }};
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  #rh-product-points-{{ block.id }} .rh-pp-balance {
    font-size: 12px;
    color: {{ block.settings.text_color }}99;
    margin-left: auto;
    white-space: nowrap;
  }
  #rh-product-points-{{ block.id }} .rh-pp-signin {
    margin-left: auto;
    font-size: 12px;
    color: {{ block.settings.primary_color }};
    text-decoration: underline;
    white-space: nowrap;
    flex-shrink: 0;
  }
  /* ── Info tooltip ─────────────────────────────────────────────────────── */
  #rh-product-points-{{ block.id }} .rh-pp-info-wrap {
    position: relative;
    flex-shrink: 0;
    margin-left: auto;
    display: flex;
    align-items: center;
  }
  #rh-product-points-{{ block.id }} .rh-pp-info-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px;
    color: {{ block.settings.primary_color }};
    opacity: 0.75;
    line-height: 1;
  }
  #rh-product-points-{{ block.id }} .rh-pp-info-btn:hover { opacity: 1; }
  #rh-product-points-{{ block.id }} .rh-pp-tooltip {
    display: none;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 240px;
    max-width: 300px;
    background: #fff;
    border: 1px solid {{ block.settings.primary_color }}33;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    padding: 12px 14px;
    z-index: 9999;
    font-size: 13px;
    color: #333;
    text-align: left;
  }
  #rh-product-points-{{ block.id }} .rh-pp-tooltip::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 6px;
    width: 10px;
    height: 10px;
    background: #fff;
    border-left: 1px solid {{ block.settings.primary_color }}33;
    border-top: 1px solid {{ block.settings.primary_color }}33;
    transform: rotate(45deg);
  }
  #rh-product-points-{{ block.id }} .rh-pp-info-wrap:hover .rh-pp-tooltip,
  #rh-product-points-{{ block.id }} .rh-pp-info-wrap.rh-active .rh-pp-tooltip {
    display: block;
  }
  #rh-product-points-{{ block.id }} .rh-pp-tooltip-list {
    margin: 0 0 6px 0;
    padding: 0 0 0 16px;
    list-style: disc;
  }
  #rh-product-points-{{ block.id }} .rh-pp-tooltip-list li {
    margin-bottom: 4px;
    line-height: 1.4;
  }
  #rh-product-points-{{ block.id }} .rh-pp-tooltip-link {
    display: inline-block;
    margin-top: 4px;
    font-size: 12px;
    color: {{ block.settings.primary_color }};
    text-decoration: underline;
  }
</style>

<script>
(function() {
  var wrap = document.getElementById('rh-pp-info-{{ block.id }}');
  if (!wrap) return;
  wrap.addEventListener('click', function(e) {
    e.stopPropagation();
    wrap.classList.toggle('rh-active');
  });
  document.addEventListener('click', function() {
    wrap.classList.remove('rh-active');
  });
})();
</script>

{% if customer %}
<script>
(function() {
  var SUPABASE_URL  = 'https://jblqyvicxhmqqjhostcj.supabase.co';
  var ANON_KEY      = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpibHF5dmljeGhtcXFqaG9zdGNqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcxOTU1MTAsImV4cCI6MjA5Mjc3MTUxMH0.pMOn3TKgzp_QqJgOlMzwO7ZRRex-mifWUzhJPwxUndE';
  var blockId       = '{{ block.id }}';
  var shopDomain    = {{ shop.permanent_domain | json }};
  var customerEmail = {{ customer.email | json }};
  var productPrice  = {{ product.price | divided_by: 100.0 }};

  if (!customerEmail) return;

  fetch(
    SUPABASE_URL + '/functions/v1/get-loyalty-status?shop_domain=' + encodeURIComponent(shopDomain) + '&email=' + encodeURIComponent(customerEmail),
    { headers: { apikey: ANON_KEY, Authorization: 'Bearer ' + ANON_KEY } }
  )
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (!data || data.error || data.points_balance == null) return;

    var rate     = (data.tier && data.tier.points_earn_rate    != null) ? data.tier.points_earn_rate    : 1;
    var divisor  = (data.tier && data.tier.points_earn_divisor != null) ? data.tier.points_earn_divisor : 1;
    var name     = (data.program && data.program.points_name)  ? data.program.points_name : '{{ block.settings.points_name }}';
    var tierName = data.tier && data.tier.name ? data.tier.name : '';
    var earned   = divisor > 0 ? Math.ceil((productPrice / divisor) * rate) : 0;
    var balance  = data.points_balance || 0;

    // Update points count and name
    var ptsEl  = document.getElementById('rh-pp-pts-'  + blockId);
    var nameEl = document.getElementById('rh-pp-name-' + blockId);
    if (ptsEl)  ptsEl.textContent  = earned;
    if (nameEl) nameEl.textContent = name;

    // Show tier badge
    {% if block.settings.show_tier_badge %}
    if (tierName) {
      var tierEl = document.getElementById('rh-pp-tier-' + blockId);
      if (tierEl) {
        tierEl.textContent    = tierName;
        tierEl.style.display  = '';
      }
    }
    {% endif %}

    // Show balance
    {% if block.settings.show_balance %}
    var balWrap = document.getElementById('rh-pp-bal-wrap-' + blockId);
    var balEl   = document.getElementById('rh-pp-bal-'      + blockId);
    var balName = document.getElementById('rh-pp-bal-name-' + blockId);
    if (balWrap && balEl) {
      balEl.textContent = balance.toLocaleString();
      if (balName) balName.textContent = name;
      balWrap.style.display = '';
    }
    {% endif %}
  })
  .catch(function() {});
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Product Points Banner",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Points Calculation"
    },
    {
      "type": "range",
      "id": "points_rate",
      "label": "Points earned per unit",
      "info": "Fallback for guests. Logged-in member rate comes from their tier.",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "points_divisor",
      "label": "Per ₹ (divisor)",
      "info": "e.g. divisor=100 → earn 1 point per ₹100 spent",
      "min": 5,
      "max": 500,
      "step": 5,
      "default": 100
    },
    {
      "type": "text",
      "id": "points_name",
      "label": "Points Name",
      "default": "Points"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text",
      "default": "Earn"
    },
    {
      "type": "header",
      "content": "Display Options"
    },
    {
      "type": "checkbox",
      "id": "show_balance",
      "label": "Show current balance (logged-in members)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_tier_badge",
      "label": "Show tier badge (logged-in members)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_signin_nudge",
      "label": "Show 'Sign in to earn' link for guests",
      "default": true
    },
    {
      "type": "header",
      "content": "Info Tooltip"
    },
    {
      "type": "checkbox",
      "id": "show_info_tooltip",
      "label": "Show ℹ info icon with tooltip",
      "default": true
    },
    {
      "type": "text",
      "id": "tooltip_line_1",
      "label": "Tooltip line 1",
      "default": "Points will be rewarded once your order is delivered"
    },
    {
      "type": "text",
      "id": "tooltip_line_2",
      "label": "Tooltip line 2",
      "default": "You will get bonus points based on the tier you are on"
    },
    {
      "type": "text",
      "id": "tooltip_line_3",
      "label": "Tooltip line 3 (optional)"
    },
    {
      "type": "text",
      "id": "tooltip_link_text",
      "label": "Tooltip link label (optional)",
      "default": "Learn more about our rewards"
    },
    {
      "type": "url",
      "id": "tooltip_link_url",
      "label": "Tooltip link URL (optional)"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Accent Color",
      "default": "#3B82F6"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#EFF6FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1E3A5F"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner Radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top (px)",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom (px)",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 8
    }
  ]
}
{% endschema %}
