{% comment %}
  Product Page Points Banner
  Shows how many points a customer earns for buying this product.
  Earn rate always comes from the GoSelf program config — no duplicate
  Theme Editor configuration needed. Guests see the default tier rate;
  logged-in members see their personalised tier rate + balance.
  Add this block to any product template in the Theme Editor → Apps → Add block.
{% endcomment %}

<div class="rh-product-points rh-ppt--{{ block.settings.template }}" id="rh-product-points-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="rh-pp-inner">

    <span class="rh-pp-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    </span>

    <div class="rh-pp-content">
      <span class="rh-pp-label">{{ block.settings.label_text }}</span>
      <strong class="rh-pp-points" id="rh-pp-pts-{{ block.id }}">…</strong>
      <span class="rh-pp-name" id="rh-pp-name-{{ block.id }}">{{ block.settings.points_name }}</span>
    </div>

    {% if block.settings.show_tier_badge %}
    <span class="rh-pp-tier" id="rh-pp-tier-{{ block.id }}" style="display:none"></span>
    {% endif %}

    {% if block.settings.show_balance %}
    <div class="rh-pp-balance" id="rh-pp-bal-wrap-{{ block.id }}" style="display:none">
      <span class="rh-pp-bal-label">Balance: </span>
      <strong id="rh-pp-bal-{{ block.id }}">0</strong>
      <span id="rh-pp-bal-name-{{ block.id }}">{{ block.settings.points_name }}</span>
    </div>
    {% endif %}

    {% if block.settings.show_signin_nudge and customer == nil %}
    <a href="/account/login" class="rh-pp-signin rh-pp-signin--{{ block.settings.signin_style }}">Sign in to earn</a>
    {% endif %}

    {% if block.settings.show_info_tooltip %}
    <div class="rh-pp-info-wrap" id="rh-pp-info-{{ block.id }}">
      <button class="rh-pp-info-btn" aria-label="Points info" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </button>
      <div class="rh-pp-tooltip" role="tooltip">
        <ul class="rh-pp-tooltip-list">
          {% unless block.settings.tooltip_line_1 == blank %}
          <li>{{ block.settings.tooltip_line_1 }}</li>
          {% endunless %}
          {% unless block.settings.tooltip_line_2 == blank %}
          <li>{{ block.settings.tooltip_line_2 }}</li>
          {% endunless %}
          {% unless block.settings.tooltip_line_3 == blank %}
          <li>{{ block.settings.tooltip_line_3 }}</li>
          {% endunless %}
        </ul>
        {% if block.settings.tooltip_link_url != blank and block.settings.tooltip_link_text != blank %}
        <a href="{{ block.settings.tooltip_link_url }}" class="rh-pp-tooltip-link" target="_blank" rel="noopener">{{ block.settings.tooltip_link_text }}</a>
        {% endif %}
      </div>
    </div>
    {% endif %}

  </div>
</div>

<style>
  /* ── Base ──────────────────────────────────────────────────────────────── */
  #rh-product-points-{{ block.id }} {
    font-family: inherit;
    {% if block.settings.text_size == 'small' %}
    font-size: 12px;
    {% elsif block.settings.text_size == 'large' %}
    font-size: 16px;
    {% else %}
    font-size: 14px;
    {% endif %}
    color: {{ block.settings.text_color }};
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
  }
  #rh-product-points-{{ block.id }} .rh-pp-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    {% if block.settings.text_align == 'center' %}
    justify-content: center;
    {% elsif block.settings.text_align == 'end' %}
    justify-content: flex-end;
    {% else %}
    justify-content: flex-start;
    {% endif %}
  }
  #rh-product-points-{{ block.id }} .rh-pp-icon {
    flex-shrink: 0;
    color: {{ block.settings.primary_color }};
    display: flex;
    align-items: center;
  }
  #rh-product-points-{{ block.id }} .rh-pp-content {
    {% if block.settings.text_align == 'start' %}flex: 1;{% endif %}
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  #rh-product-points-{{ block.id }} .rh-pp-points {
    color: {{ block.settings.primary_color }};
    font-weight: 700;
    {% if block.settings.text_size == 'small' %}
    font-size: 14px;
    {% elsif block.settings.text_size == 'large' %}
    font-size: 19px;
    {% else %}
    font-size: 16px;
    {% endif %}
  }
  #rh-product-points-{{ block.id }} .rh-pp-name {
    font-weight: 600;
    color: {{ block.settings.primary_color }};
  }
  #rh-product-points-{{ block.id }} .rh-pp-tier {
    background: {{ block.settings.primary_color }};
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  #rh-product-points-{{ block.id }} .rh-pp-balance {
    font-size: 12px;
    color: {{ block.settings.text_color }}99;
    {% if block.settings.text_align == 'start' %}margin-left: auto;{% endif %}
    white-space: nowrap;
  }

  /* ── Sign-in styles ────────────────────────────────────────────────────── */
  #rh-product-points-{{ block.id }} .rh-pp-signin {
    {% if block.settings.text_align == 'start' %}margin-left: auto;{% endif %}
    white-space: nowrap;
    flex-shrink: 0;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
  }
  #rh-product-points-{{ block.id }} .rh-pp-signin--link {
    color: {{ block.settings.primary_color }};
    text-decoration: underline;
  }
  #rh-product-points-{{ block.id }} .rh-pp-signin--button {
    color: {{ block.settings.primary_color }};
    border: 1.5px solid {{ block.settings.primary_color }};
    border-radius: 6px;
    padding: 5px 13px;
    background: transparent;
    transition: background 0.15s;
  }
  #rh-product-points-{{ block.id }} .rh-pp-signin--button:hover {
    background: {{ block.settings.primary_color }}15;
  }
  #rh-product-points-{{ block.id }} .rh-pp-signin--badge {
    color: #fff;
    background: {{ block.settings.primary_color }};
    border-radius: 20px;
    padding: 5px 14px;
  }

  /* ── Template: card ────────────────────────────────────────────────────── */
  #rh-product-points-{{ block.id }}.rh-ppt--card .rh-pp-inner {
    background: {{ block.settings.bg_color }};
    border: 1.5px solid {{ block.settings.primary_color }}33;
    border-radius: {{ block.settings.border_radius }}px;
    padding: 10px 14px;
  }

  /* ── Template: minimal ─────────────────────────────────────────────────── */
  #rh-product-points-{{ block.id }}.rh-ppt--minimal .rh-pp-inner {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 8px 0;
  }

  /* ── Template: strip ───────────────────────────────────────────────────── */
  #rh-product-points-{{ block.id }}.rh-ppt--strip .rh-pp-inner {
    background: {{ block.settings.primary_color }};
    border: none;
    border-radius: 0;
    padding: 10px 16px;
  }
  /* Strip: base elements use primary_color — override them so they show against the accent bg */
  #rh-product-points-{{ block.id }}.rh-ppt--strip .rh-pp-points,
  #rh-product-points-{{ block.id }}.rh-ppt--strip .rh-pp-name,
  #rh-product-points-{{ block.id }}.rh-ppt--strip .rh-pp-icon,
  #rh-product-points-{{ block.id }}.rh-ppt--strip .rh-pp-info-btn { color: {{ block.settings.text_color }}; }
  #rh-product-points-{{ block.id }}.rh-ppt--strip .rh-pp-tier { background: {{ block.settings.text_color }}30; color: {{ block.settings.text_color }}; }
  #rh-product-points-{{ block.id }}.rh-ppt--strip .rh-pp-signin--link { color: {{ block.settings.text_color }}; opacity: 0.9; text-decoration: underline; }
  #rh-product-points-{{ block.id }}.rh-ppt--strip .rh-pp-signin--button { color: {{ block.settings.text_color }}; border-color: {{ block.settings.text_color }}80; background: transparent; }
  #rh-product-points-{{ block.id }}.rh-ppt--strip .rh-pp-signin--button:hover { background: {{ block.settings.text_color }}15; }
  #rh-product-points-{{ block.id }}.rh-ppt--strip .rh-pp-signin--badge { color: {{ block.settings.primary_color }}; background: {{ block.settings.text_color }}; }

  /* ── Template: pill ────────────────────────────────────────────────────── */
  #rh-product-points-{{ block.id }}.rh-ppt--pill {
    {% if block.settings.text_align == 'center' %}text-align: center;
    {% elsif block.settings.text_align == 'end' %}text-align: right;
    {% else %}text-align: left;{% endif %}
  }
  #rh-product-points-{{ block.id }}.rh-ppt--pill .rh-pp-inner {
    display: inline-flex;
    background: {{ block.settings.bg_color }};
    border: 1.5px solid {{ block.settings.primary_color }}33;
    border-radius: 9999px;
    padding: 6px 18px;
  }

  /* ── Info tooltip ─────────────────────────────────────────────────────── */
  #rh-product-points-{{ block.id }} .rh-pp-info-wrap {
    position: relative;
    flex-shrink: 0;
    {% if block.settings.text_align == 'start' %}margin-left: auto;{% endif %}
    display: flex;
    align-items: center;
  }
  #rh-product-points-{{ block.id }} .rh-pp-info-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px;
    color: {{ block.settings.primary_color }};
    opacity: 0.75;
    line-height: 1;
  }
  #rh-product-points-{{ block.id }} .rh-pp-info-btn:hover { opacity: 1; }
  #rh-product-points-{{ block.id }} .rh-pp-tooltip {
    display: none;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 240px;
    max-width: 300px;
    background: #fff;
    border: 1px solid {{ block.settings.primary_color }}33;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    padding: 12px 14px;
    z-index: 9999;
    font-size: 13px;
    color: #333;
    text-align: left;
  }
  #rh-product-points-{{ block.id }} .rh-pp-tooltip::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 6px;
    width: 10px;
    height: 10px;
    background: #fff;
    border-left: 1px solid {{ block.settings.primary_color }}33;
    border-top: 1px solid {{ block.settings.primary_color }}33;
    transform: rotate(45deg);
  }
  #rh-product-points-{{ block.id }} .rh-pp-info-wrap:hover .rh-pp-tooltip,
  #rh-product-points-{{ block.id }} .rh-pp-info-wrap.rh-active .rh-pp-tooltip {
    display: block;
  }
  #rh-product-points-{{ block.id }} .rh-pp-tooltip-list {
    margin: 0 0 6px 0;
    padding: 0 0 0 16px;
    list-style: disc;
  }
  #rh-product-points-{{ block.id }} .rh-pp-tooltip-list li {
    margin-bottom: 4px;
    line-height: 1.4;
  }
  #rh-product-points-{{ block.id }} .rh-pp-tooltip-link {
    display: inline-block;
    margin-top: 4px;
    font-size: 12px;
    color: {{ block.settings.primary_color }};
    text-decoration: underline;
  }
</style>

<script>
(function() {
  var SUPABASE_URL  = 'https://jblqyvicxhmqqjhostcj.supabase.co';
  var ANON_KEY      = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpibHF5dmljeGhtcXFqaG9zdGNqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcxOTU1MTAsImV4cCI6MjA5Mjc3MTUxMH0.pMOn3TKgzp_QqJgOlMzwO7ZRRex-mifWUzhJPwxUndE';
  var blockId       = '{{ block.id }}';
  var shopDomain    = {{ shop.permanent_domain | json }};
  var customerEmail = {{ customer.email | json }};
  var productPrice  = {{ product.price | divided_by: 100.0 }};

  // ── Tooltip toggle (desktop hover + mobile tap) ──────────────────────────
  var infoWrap = document.getElementById('rh-pp-info-' + blockId);
  if (infoWrap) {
    infoWrap.addEventListener('click', function(e) {
      e.stopPropagation();
      infoWrap.classList.toggle('rh-active');
    });
    document.addEventListener('click', function() {
      infoWrap.classList.remove('rh-active');
    });
  }

  // ── Earn rate fetch — guests get program default, members get tier rate ──
  if (!shopDomain) return;
  var url = SUPABASE_URL + '/functions/v1/get-loyalty-status?shop_domain=' + encodeURIComponent(shopDomain);
  if (customerEmail) url += '&email=' + encodeURIComponent(customerEmail);

  fetch(url, { headers: { apikey: ANON_KEY, Authorization: 'Bearer ' + ANON_KEY } })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (!data || data.error) return;

    // Rate priority: member tier > guest program default > 1
    var rate    = (data.tier && data.tier.points_earn_rate    != null) ? data.tier.points_earn_rate
                : (data.default_earn_rate    != null ? data.default_earn_rate    : 1);
    var divisor = (data.tier && data.tier.points_earn_divisor != null) ? data.tier.points_earn_divisor
                : (data.default_earn_divisor != null ? data.default_earn_divisor : 1);
    var name    = (data.program && data.program.points_name) ? data.program.points_name : '{{ block.settings.points_name }}';
    var earned  = divisor > 0 ? Math.ceil((productPrice / divisor) * rate) : 0;

    var ptsEl  = document.getElementById('rh-pp-pts-'  + blockId);
    var nameEl = document.getElementById('rh-pp-name-' + blockId);
    if (ptsEl)  ptsEl.textContent  = earned;
    if (nameEl) nameEl.textContent = name;

    if (data.guest) return; // guests: points shown, no balance/tier badge

    var balance  = data.points_balance || 0;
    var tierName = data.tier && data.tier.name ? data.tier.name : '';

    {% if block.settings.show_tier_badge %}
    if (tierName) {
      var tierEl = document.getElementById('rh-pp-tier-' + blockId);
      if (tierEl) { tierEl.textContent = tierName; tierEl.style.display = ''; }
    }
    {% endif %}

    {% if block.settings.show_balance %}
    var balWrap = document.getElementById('rh-pp-bal-wrap-' + blockId);
    var balEl   = document.getElementById('rh-pp-bal-'      + blockId);
    var balName = document.getElementById('rh-pp-bal-name-' + blockId);
    if (balWrap && balEl) {
      balEl.textContent = balance.toLocaleString();
      if (balName) balName.textContent = name;
      balWrap.style.display = '';
    }
    {% endif %}
  })
  .catch(function() {});
})();
</script>

{% schema %}
{
  "name": "Product Points Banner",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "template",
      "label": "Banner Style",
      "info": "Pick a style. Use Styling settings below to customise colours and spacing.",
      "options": [
        { "value": "card",    "label": "Card — coloured background box (default)" },
        { "value": "minimal", "label": "Minimal — text only, no background" },
        { "value": "strip",   "label": "Strip — full-width accent colour bar" },
        { "value": "pill",    "label": "Pill — compact badge, floats inline" }
      ],
      "default": "card"
    },
    {
      "type": "text",
      "id": "points_name",
      "label": "Points Name",
      "info": "Shown while the earn rate loads. Overridden by your GoSelf program name.",
      "default": "Points"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text",
      "default": "Earn"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "start",  "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "end",    "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text Size",
      "options": [
        { "value": "small",  "label": "Small" },
        { "value": "medium", "label": "Medium (default)" },
        { "value": "large",  "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Display Options"
    },
    {
      "type": "checkbox",
      "id": "show_balance",
      "label": "Show current balance (logged-in members)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_tier_badge",
      "label": "Show tier badge (logged-in members)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_signin_nudge",
      "label": "Show 'Sign in to earn' for guests",
      "default": true
    },
    {
      "type": "select",
      "id": "signin_style",
      "label": "Sign-in style",
      "info": "How the sign-in call-to-action looks when shown to guests.",
      "options": [
        { "value": "link",   "label": "Link — underlined text" },
        { "value": "button", "label": "Button — outlined pill" },
        { "value": "badge",  "label": "Badge — filled accent chip" }
      ],
      "default": "link"
    },
    {
      "type": "header",
      "content": "Info Tooltip"
    },
    {
      "type": "checkbox",
      "id": "show_info_tooltip",
      "label": "Show ℹ info icon with tooltip",
      "default": true
    },
    {
      "type": "text",
      "id": "tooltip_line_1",
      "label": "Tooltip line 1",
      "default": "Points will be rewarded once your order is delivered"
    },
    {
      "type": "text",
      "id": "tooltip_line_2",
      "label": "Tooltip line 2",
      "default": "You will get bonus points based on the tier you are on"
    },
    {
      "type": "text",
      "id": "tooltip_line_3",
      "label": "Tooltip line 3 (optional)"
    },
    {
      "type": "text",
      "id": "tooltip_link_text",
      "label": "Tooltip link label (optional)",
      "default": "Learn more about our rewards"
    },
    {
      "type": "url",
      "id": "tooltip_link_url",
      "label": "Tooltip link URL (optional)"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Accent Color",
      "info": "Strip template uses this as its background colour.",
      "default": "#3B82F6"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "info": "Applies to Card and Pill templates. Ignored by Strip.",
      "default": "#EFF6FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "info": "For Strip, use a colour that reads well against your Accent Color — typically white (#ffffff).",
      "default": "#1E3A5F"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner Radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top (px)",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom (px)",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 8
    }
  ]
}
{% endschema %}
