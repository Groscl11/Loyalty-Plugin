{% comment %}
  Collection Page Points Banner
  Shows a site-wide "Earn points on every purchase" nudge on collection pages.
  For logged-in members it fetches their personalised tier rate and injects
  per-product badges directly onto the product cards in the collection grid.
  Add this block to any collection template in the Theme Editor → Apps → Add block.
{% endcomment %}

<div class="rh-col-points" id="rh-col-points-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="rh-colp-inner">

    <span class="rh-colp-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    </span>

    <div class="rh-colp-content">
      <span class="rh-colp-label" id="rh-colp-label-{{ block.id }}">{{ block.settings.label_text }}</span>
      <strong class="rh-colp-rate" id="rh-colp-rate-{{ block.id }}">
        {{ block.settings.points_rate }} {{ block.settings.points_name }} per ₹{{ block.settings.points_divisor }}
      </strong>
    </div>

    {% if block.settings.show_tier_badge %}
    <span class="rh-colp-tier" id="rh-colp-tier-{{ block.id }}" style="display:none"></span>
    {% endif %}

    {% if block.settings.show_balance %}
    <div class="rh-colp-balance" id="rh-colp-bal-wrap-{{ block.id }}" style="display:none">
      <span class="rh-colp-bal-label">Balance: </span>
      <strong id="rh-colp-bal-{{ block.id }}">0</strong>
      <span id="rh-colp-bal-name-{{ block.id }}">{{ block.settings.points_name }}</span>
    </div>
    {% endif %}

    {% if block.settings.show_signin_nudge and customer == nil %}
    <a href="/account/login" class="rh-colp-signin">Sign in to earn</a>
    {% endif %}

  </div>
</div>

<style>
  #rh-col-points-{{ block.id }} {
    font-family: inherit;
    font-size: 14px;
    color: {{ block.settings.text_color }};
  }
  #rh-col-points-{{ block.id }} .rh-colp-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    background: {{ block.settings.bg_color }};
    border: 1.5px solid {{ block.settings.accent_color }}33;
    border-radius: {{ block.settings.border_radius }}px;
    padding: 12px 16px;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
  }
  #rh-col-points-{{ block.id }} .rh-colp-icon {
    flex-shrink: 0;
    color: {{ block.settings.accent_color }};
    display: flex;
    align-items: center;
  }
  #rh-col-points-{{ block.id }} .rh-colp-content {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  #rh-col-points-{{ block.id }} .rh-colp-rate {
    color: {{ block.settings.accent_color }};
    font-weight: 700;
    font-size: 15px;
  }
  #rh-col-points-{{ block.id }} .rh-colp-tier {
    background: {{ block.settings.accent_color }};
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  #rh-col-points-{{ block.id }} .rh-colp-balance {
    font-size: 12px;
    color: {{ block.settings.text_color }}99;
    margin-left: auto;
    white-space: nowrap;
  }
  #rh-col-points-{{ block.id }} .rh-colp-signin {
    margin-left: auto;
    font-size: 12px;
    color: {{ block.settings.accent_color }};
    text-decoration: underline;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Per-product badge injected by JS into collection grid cards */
  .rh-prod-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: {{ block.settings.accent_color }}18;
    border: 1px solid {{ block.settings.accent_color }}44;
    color: {{ block.settings.accent_color }};
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    margin-top: 4px;
    white-space: nowrap;
  }
</style>

{% if customer %}
<script>
(function() {
  var SUPABASE_URL = 'https://jblqyvicxhmqqjhostcj.supabase.co';
  var ANON_KEY     = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpibHF5dmljeGhtcXFqaG9zdGNqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcxOTU1MTAsImV4cCI6MjA5Mjc3MTUxMH0.pMOn3TKgzp_QqJgOlMzwO7ZRRex-mifWUzhJPwxUndE';
  var blockId       = '{{ block.id }}';
  var shopDomain    = {{ shop.permanent_domain | json }};
  var customerEmail = {{ customer.email | json }};
  var injectBadges  = {{ block.settings.inject_product_badges }};
  var pointsName    = '{{ block.settings.points_name }}';
  var divisor       = {{ block.settings.points_divisor }};
  var rate          = {{ block.settings.points_rate }};

  if (!customerEmail) return;

  fetch(
    SUPABASE_URL + '/functions/v1/get-loyalty-status?shop_domain=' + encodeURIComponent(shopDomain) + '&email=' + encodeURIComponent(customerEmail),
    { headers: { apikey: ANON_KEY, Authorization: 'Bearer ' + ANON_KEY } }
  )
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (!data || data.error || data.points_balance == null) return;

    rate    = (data.tier && data.tier.points_earn_rate    != null) ? data.tier.points_earn_rate    : rate;
    divisor = (data.tier && data.tier.points_earn_divisor != null) ? data.tier.points_earn_divisor : divisor;
    var name    = (data.program && data.program.points_name) ? data.program.points_name : pointsName;
    var balance = data.points_balance || 0;
    var tierName = data.tier && data.tier.name ? data.tier.name : '';

    // Update banner rate text
    var rateEl = document.getElementById('rh-colp-rate-' + blockId);
    if (rateEl) rateEl.textContent = rate + ' ' + name + ' per ₹' + divisor;

    // Show tier badge
    {% if block.settings.show_tier_badge %}
    if (tierName) {
      var tierEl = document.getElementById('rh-colp-tier-' + blockId);
      if (tierEl) {
        tierEl.textContent = tierName;
        tierEl.style.display = '';
      }
    }
    {% endif %}

    // Show balance
    {% if block.settings.show_balance %}
    var balWrap = document.getElementById('rh-colp-bal-wrap-' + blockId);
    var balEl   = document.getElementById('rh-colp-bal-' + blockId);
    var balName = document.getElementById('rh-colp-bal-name-' + blockId);
    if (balWrap && balEl) {
      balEl.textContent = balance.toLocaleString();
      if (balName) balName.textContent = name;
      balWrap.style.display = '';
    }
    {% endif %}

    // Inject per-product badges into collection grid
    if (injectBadges) {
      injectProductBadges(rate, divisor, name);
    }
  })
  .catch(function() {});

  function injectProductBadges(earnRate, earnDivisor, name) {
    // Common Shopify theme selectors for product price elements
    // Works with Dawn, Debut, Sense, Refresh, and most custom themes
    var priceSelectors = [
      '.product-item__price .price__regular .price-item--regular',
      '.price__regular .price-item--regular',
      '.product-card__price .price-item--regular',
      '[data-regular-price]',
      '.product-item__price',
      '.card__information .price',
    ];

    // Try each selector until we find product cards
    var priceElements = [];
    for (var i = 0; i < priceSelectors.length; i++) {
      priceElements = document.querySelectorAll(priceSelectors[i]);
      if (priceElements.length > 0) break;
    }

    if (priceElements.length === 0) return;

    priceElements.forEach(function(el) {
      // Skip if badge already injected
      if (el.parentNode && el.parentNode.querySelector('.rh-prod-badge')) return;

      // Parse price from element text (handles ₹, $, commas)
      var priceText = el.textContent.replace(/[^\d.]/g, '').trim();
      var price = parseFloat(priceText);
      if (!price || isNaN(price)) return;

      var pts = earnDivisor > 0 ? Math.floor((price / earnDivisor) * earnRate) : 0;
      if (pts <= 0) return;

      var badge = document.createElement('span');
      badge.className = 'rh-prod-badge';
      badge.innerHTML = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> ' + pts + ' ' + name;
      el.parentNode.insertBefore(badge, el.nextSibling);
    });
  }
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Collection Points Banner",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Points Display"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label Text",
      "default": "Shop & earn"
    },
    {
      "type": "range",
      "id": "points_rate",
      "label": "Points earned per unit",
      "info": "Fallback for guests. Logged-in member rate comes from their tier.",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "points_divisor",
      "label": "Per ₹ (divisor)",
      "info": "e.g. divisor=100 → earn 1 point per ₹100 spent",
      "min": 1,
      "max": 1000,
      "step": 1,
      "default": 100
    },
    {
      "type": "text",
      "id": "points_name",
      "label": "Points Name",
      "default": "Points"
    },
    {
      "type": "header",
      "content": "Display Options"
    },
    {
      "type": "checkbox",
      "id": "show_balance",
      "label": "Show current balance (logged-in members)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_tier_badge",
      "label": "Show tier badge (logged-in members)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "inject_product_badges",
      "label": "Inject points badges on product cards",
      "info": "Adds 'X Points' badge below prices in the collection grid for logged-in members.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_signin_nudge",
      "label": "Show 'Sign in to earn' link for guests",
      "default": true
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#3B82F6"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#EFF6FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1E3A5F"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner Radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top (px)",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom (px)",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
